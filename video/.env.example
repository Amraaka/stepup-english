# Used by scripts/generate.ts for the voice clips (the only paid step)
OPENAI_API_KEY=sk-proj-...
# Optional overrides
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Posting to Instagram + Facebook (README → Posting)
# For npm run meta-setup — the user token comes from Graph API Explorer and expires in about an hour
# META_APP_ID=
# META_APP_SECRET=
# META_USER_TOKEN=
# Written by npm run meta-setup
# META_PAGE_ID=
# META_IG_USER_ID=
# META_PAGE_TOKEN=
# How the voice should sound (gpt-4o voices only)
# OPENAI_TTS_INSTRUCTIONS=Speak clearly and naturally, at a slightly slow pace, for adult English learners.
