# Supabase — get these from your Supabase project settings (API section)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Google login (local Supabase reads this from supabase/.env; hosted projects set it in the dashboard)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
