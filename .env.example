# Supabase — get these from your Supabase project settings (API section)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Google login (local Supabase reads this from supabase/.env; hosted projects set it in the dashboard)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# AI pronunciation scoring (ADR 0011). Leave empty and the feature shows "Тун удахгүй".
# Endpoint is the Speech resource, e.g. https://your-resource.cognitiveservices.azure.com
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_ENDPOINT=
# Development only: fake scores to work on the result UI without a key
# PRONUNCIATION_PROVIDER=mock
